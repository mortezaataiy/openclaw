# OpenClaw Docker Configuration
# Copy this file to .env and customize as needed

# Docker image to use (default: openclaw:local for local builds)
OPENCLAW_IMAGE=openclaw:local

# Gateway authentication token (generate with: openssl rand -hex 32)
# OPTIONAL when using loopback bind (127.0.0.1 only)
# REQUIRED when using lan bind (external access)
OPENCLAW_GATEWAY_TOKEN=

# API Keys
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=

# Claude AI session keys (optional, for AI features)
CLAUDE_AI_SESSION_KEY=
CLAUDE_WEB_SESSION_KEY=
CLAUDE_WEB_COOKIE=

# Directory paths (defaults shown)
OPENCLAW_CONFIG_DIR=${HOME}/.openclaw
OPENCLAW_WORKSPACE_DIR=${HOME}/.openclaw/workspace

# Gateway ports
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790

# Gateway bind address (loopback for local only, lan for external access)
# loopback = 127.0.0.1 (no SSL required, access via port mapping)
# lan = 0.0.0.0 (requires SSL for external access)
OPENCLAW_GATEWAY_BIND=loopback

# Additional APT packages to install (space-separated)
OPENCLAW_DOCKER_APT_PACKAGES=
