# OpenClaw Docker Configuration
# کپی کنید به .env و مقادیر را تنظیم کنید

# ═══════════════════════════════════════════════════════════
# تنظیمات اصلی (Required)
# ═══════════════════════════════════════════════════════════

# Docker Image
# - برای build محلی: openclaw:local
# - برای استفاده از GitHub: ghcr.io/USERNAME/REPO:TAG
OPENCLAW_IMAGE=openclaw:local

# Gateway Token (اختیاری - اگر خالی باشد، خودکار تولید می‌شود)
# OPENCLAW_GATEWAY_TOKEN=

# ═══════════════════════════════════════════════════════════
# مسیرها (Paths)
# ═════════════════════════════════════════════════════════
rk)
# ═══════════════════════════════════════════════════════════

# Gateway Bind Mode
# - loopback: فقط localhost (127.0.0.1)
# - lan: دسترسی از شبکه محلی
OPENCLAW_GATEWAY_BIND=lan

# ═══════════════════════════════════════════════════════════
# تنظیمات پیشرفته (Advanced)
# ═══════════════════════════════════════════════════════════

# Volume برای ذخیره دائمی /home/node (اختیاری)
# مثال: OPENCLAW_HOME_VOLUME=openclaw_home
OPENCLAW_HOME_VOLUME=

# Mount های اضافی (اختیاری، جدا شده با کاما)
# مثال: OPENCLAW_EXTRA_MOUNTS=$HOME/projects:/home/node/projects:rw,$HOME/.ssh:/home/node/.ssh:ro
OPENCLAW_EXTRA_MOUNTS=

# پکیج‌های apt اضافی برای نصب در image (اختیاری)
# مثال: OPENCLAW_DOCKER_APT_PACKAGES=ffmpeg git curl jq
OPENCLAW_DOCKER_APT_PACKAGES=

# ═══════════════════════════════════════════════════════════
# کلیدهای Provider (اختیاری)
# ═══════════════════════════════════════════════════════════

# Claude AI Session Key
# CLAUDE_AI_SESSION_KEY=

# Claude Web Session Key
# CLAUDE_WEB_SESSION_KEY=

# Claude Web Cookie
# CLAUDE_WEB_COOKIE=

# ═══════════════════════════════════════════════════════════
# نکات
# ═══════════════════════════════════════════════════════════
#
# 1. برای استفاده:
#    cp .env.docker.example .env
#    nano .env  # ویرایش مقادیر
#    ./docker-setup-auto.sh
#
# 2. برای استفاده از GitHub image:
#    OPENCLAW_IMAGE=ghcr.io/myusername/openclaw:latest
#
# 3. برای ذخیره دائمی کش‌ها و مرورگرها:
#    OPENCLAW_HOME_VOLUME=openclaw_home
#
# 4. مستندات: https://docs.openclaw.ai/install/docker-fa
