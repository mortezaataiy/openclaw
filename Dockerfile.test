# Dockerfile.test - برای تست سریع entrypoint
FROM node:22-slim

WORKDIR /app

# نصب ابزارهای مورد نیاز
RUN apt-get update && \
    apt-get install -y openssl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ساخت ساختار پوشه‌های مورد نیاز
RUN mkdir -p dist && \
    chown -R node:node /app

# یک فایل ساده برای شبیه‌سازی openclaw
RUN echo 'console.log("OpenClaw Gateway Mock");' > dist/index.js && \
    echo 'console.log("Gateway started on port:", process.env.OPENCLAW_GATEWAY_PORT || 18789);' >> dist/index.js && \
    echo 'console.log("Bind mode:", process.env.OPENCLAW_GATEWAY_BIND || "lan");' >> dist/index.js && \
    echo 'console.log("Token:", process.env.OPENCLAW_GATEWAY_TOKEN || "not-set");' >> dist/index.js && \
    echo 'setInterval(() => {}, 1000);' >> dist/index.js

# کپی entrypoint
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

USER node

ENV NODE_ENV=production

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD []
