# ═══════════════════════════════════════════════════════════
# OpenClaw Docker - تنظیمات ساده
# ═══════════════════════════════════════════════════════════
# کپی کنید به .env و استفاده کنید:
#   cp .env.simple .env
#   docker compose -f docker-compose.simple.yml up -d
# ═══════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# Image (مهم!)
# ─────────────────────────────────────────────────────────────
# از GitHub Container Registry (توصیه می‌شود):
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# یا image محلی (نیاز به build):
# OPENCLAW_IMAGE=openclaw:local

# ─────────────────────────────────────────────────────────────
# Token (اختیاری - خودکار تولید می‌شود)
# ─────────────────────────────────────────────────────────────
# اگر خالی باشد، container خودش یکی می‌سازد
OPENCLAW_GATEWAY_TOKEN=

# ─────────────────────────────────────────────────────────────
# مسیرها (اختیاری - پیش‌فرض: ~/.openclaw)
# ─────────────────────────────────────────────────────────────
OPENCLAW_CONFIG_DIR=~/.openclaw
OPENCLAW_WORKSPACE_DIR=~/.openclaw/workspace

# ─────────────────────────────────────────────────────────────
# پورت‌ها (اختیاری)
# ─────────────────────────────────────────────────────────────
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790

# ─────────────────────────────────────────────────────────────
# شبکه (اختیاری)
# ─────────────────────────────────────────────────────────────
# loopback = فقط localhost
# lan = دسترسی از شبکه محلی
OPENCLAW_GATEWAY_BIND=lan

# ─────────────────────────────────────────────────────────────
# کلیدهای Provider (اختیاری)
# ─────────────────────────────────────────────────────────────
# CLAUDE_AI_SESSION_KEY=
# CLAUDE_WEB_SESSION_KEY=
# CLAUDE_WEB_COOKIE=

# ─────────────────────────────────────────────────────────────
# Volume برای ذخیره دائمی (اختیاری)
# ─────────────────────────────────────────────────────────────
# برای فعال‌سازی، uncomment کنید و در docker-compose.simple.yml
# هم uncomment کنید
# OPENCLAW_HOME_VOLUME=openclaw_home
